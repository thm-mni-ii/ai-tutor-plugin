# Copy this file to .env and fill in the values for local development.
# .env is gitignored — never commit real credentials.

# ai-tutor-backend FastAPI service base URL. Chat streaming, queue position,
# and auth all go through this service now — the plugin no longer talks to
# the LLM directly. Defaults to the THM test deployment if unset.
# For local dev, point this at your local `uvicorn main:app` instance, e.g.:
JUPYTERHUB_BASE_URL=http://localhost:8000
BACKEND_URL=/
TEST_DEPLOYMENT=true
