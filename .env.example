# Copy this file to .env and fill in the values for local development.
# .env is gitignored — never commit real credentials.

# OpenAI-compatible LLM endpoint (defaults to THM server if unset)
LLM_URL=https://ki6.mni.thm.de:4443/v1/chat/completions

# Bearer token for the LLM API — required, no default
LLM_TOKEN=

# Model name to request — required, no default
LLM_MODEL=

# Your THM student username — only needed for local development (localhost:8888).
# This is the same username you use to log into JupyterHub at THM (e.g. mamu1234).
# On JupyterHub in production this is extracted automatically from the Hub identity.
JUPYTER_USERNAME=
